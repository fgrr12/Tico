<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Agent app: tray icon only, no Dock icon and no Cmd-Tab entry. The window
	     config's `skipTaskbar` does nothing here — that is a Windows and Linux
	     option. Declaring it in the plist as well as calling
	     set_activation_policy in setup() is what stops the Dock icon from
	     flashing during the moment before setup() runs. -->
	<!-- Required for the music detection in music.rs. Without it a bundled build
	     is denied Apple Events by the OS, which reads as tico simply never
	     noticing that anything is playing. -->
	<key>NSAppleEventsUsageDescription</key>
	<string>tico reads the track you are playing from Spotify and Music, so he can sing along.</string>

	<!-- Experiment: the calendar, read as start, end and head count only. macOS
	     14 asks for the FullAccess key; older systems read the plain one. -->
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>tico looks at when your next meeting starts, so he can get nervous about it with you. He never reads its title.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>tico looks at when your next meeting starts, so he can get nervous about it with you. He never reads its title.</string>

	<key>LSUIElement</key>
	<true/>
</dict>
</plist>
